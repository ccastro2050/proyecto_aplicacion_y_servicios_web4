# Compilados de .NET (los genera dotnet build; jamás se versionan)
bin/
obj/

# Archivos de sesión de SQLTools (borradores personales de SQL)
*.session.sql

# Archivos de usuario de IDEs
*.user
.vs/

# Los documentos del aula viven en .md: el .docx se desfasaba y nadie avisaba
*.docx

# La spec de la v5 (otros motores) NO se publica: el curso son cuatro
# versiones y al estudiante se le proyecta la v5, no se le muestra. La
# carpeta se queda en el disco —trabajo en curso—, pero fuera de GitHub.
docs/spec_kit/versiones/v5_otros_motores/

# La configuracion de PRODUCCION trae la contrasena real de la base de
# datos del hospedaje. Se versiona la plantilla -appsettings.Production.json.ejemplo-,
# nunca el archivo con el valor puesto.
appsettings.Production.json

# La carpeta que produce  dotnet publish -o publicado : es resultado de
# compilar, se regenera con un comando, y ademas se lleva adentro el
# appsettings.Production.json con la contrasena.
publicado/

# EXCEPCION: la del front no tiene secretos -solo la direccion publica de
# la API-, asi que esa si se versiona.
!front_blazor/appsettings.Production.json

# La variante PostgreSQL: trae la contrasena de Neon.
appsettings.Production.postgres.json

# Compilados de Python: los genera el interprete al importar, y en el
# contenedor los crea root. No se versionan.
__pycache__/
*.pyc
publicado_pg/

# Las salidas de  dotnet publish  viven FUERA de las carpetas de proyecto:
# dentro, el contenedor las vigila y recompila en ciclo, y ademas el SDK
# las mete en el siguiente paquete. Ver TUTORIAL_PUBLICAR.md 8.10.
publicados/

# EXCEPCION: la variante PostgreSQL del front tampoco tiene secretos.
!front_blazor/appsettings.Production.postgres.json

# Dependencias y compilados de Node: los baja npm y los genera vite.
node_modules/
dist/
