@inject EstadoSesion Estado
@inject NavigationManager Navegador
@implements IDisposable

@*
   Quién está identificado, y cómo salir. Pequeño, y hace falta: sin esto nadie
   sabe con qué sesión está mirando — y el criterio 8 es justamente que el menú
   cambie según el rol, así que hay que poder ver CUÁL rol.
*@
@if (Estado.Identificado)
{
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2
                bg-body-tertiary border rounded-3 px-3 py-2 mb-4">
        <div class="small">
            <span class="fw-semibold">@Estado.Email</span>
            @foreach (var r in Estado.Roles)
            {
                <span class="badge text-bg-secondary ms-1">@r</span>
            }
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Salir">Salir</button>
    </div>
}

@code {
    protected override void OnInitialized() => Estado.Cambio += Redibujar;

    private void Redibujar() => InvokeAsync(StateHasChanged);

    private void Salir()
    {
        Estado.Salir();
        Navegador.NavigateTo("/sesion");
    }

    public void Dispose() => Estado.Cambio -= Redibujar;
}
