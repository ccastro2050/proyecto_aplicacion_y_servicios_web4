@page "/facturas/{Numero:int}"
@inject ServicioFactura Servicio
@inject EstadoSesion Estado
@inject NavigationManager Navegador

@*
   ============================================================
   EL DETALLE DE UNA FACTURA — la misma pantalla que en el front de Flask del
   otro curso.

   LOS SUBTOTALES NO LOS CALCULA ESTA PAGINA: vienen de la base, puestos por el
   disparador cuando la factura se emitio. Si aqui se multiplicara cantidad por
   valor unitario habria dos fuentes de verdad — y el dia que no coincidan,
   gana la que nadie reviso.
   ============================================================
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">
        Factura @Numero
        @if (factura is not null)
        {
            <span class="badge @(factura.Estado == "activa" ? "bg-success" : "bg-danger")">
                @factura.Estado
            </span>
        }
    </h1>
    <a class="btn btn-outline-secondary" href="facturas">Volver</a>
</div>

@if (aviso is not null)
{
    <div class="alert alert-danger" role="alert">@aviso</div>
}

@if (cargando)
{
    <p>Cargando…</p>
}
else if (factura is not null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-6 col-md-3"><strong>Fecha:</strong><br />@FechaCorta(factura.Fecha)</div>
                @* Estos nombres NO los busco el front: vienen resueltos porque
                   el JOIN lo hizo el procedimiento almacenado. *@
                <div class="col-6 col-md-3"><strong>Cliente:</strong><br />@factura.NombreCliente</div>
                <div class="col-6 col-md-3"><strong>Vendedor:</strong><br />@factura.NombreVendedor</div>
                <div class="col-6 col-md-3">
                    <strong>Total:</strong><br />
                    <span class="font-monospace">@factura.Total.ToString("N0")</span>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4">Renglones (los subtotales los calculó la base de datos)</h2>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Producto</th><th>Nombre</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Valor unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in factura.Productos)
                {
                    <tr>
                        <td class="font-monospace">@p.CodigoProducto</td>
                        <td>@p.NombreProducto</td>
                        <td class="text-end font-monospace">@p.Cantidad</td>
                        <td class="text-end font-monospace">@p.Valorunitario.ToString("N0")</td>
                        @* El subtotal lo calculo el trigger. *@
                        <td class="text-end font-monospace">@p.Subtotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public int Numero { get; set; }

    private Factura? factura;
    private bool cargando = true;
    private string? aviso;

    protected override async Task OnInitializedAsync()
    {
        if (!Estado.Identificado)
        {
            Navegador.NavigateTo("/sesion");
            return;
        }

        var r = await Servicio.ConsultarAsync(Numero);
        cargando = false;
        if (r.Bien) { factura = r.Dato; } else { aviso = r.Mensaje; }
    }

    /// <summary>La fecha llega como texto ISO del procedimiento. Si no se puede
    /// leer, se muestra tal cual: romper la interfaz por una fecha no.</summary>
    private static string FechaCorta(string? iso) =>
        DateTime.TryParse(iso, out var d) ? d.ToString("yyyy-MM-dd") : (iso ?? "—");
}
