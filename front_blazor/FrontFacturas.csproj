<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FrontFacturas</RootNamespace>
  </PropertyGroup>

  <!-- Sin paquetes: Blazor Server viene en el SDK web, y el front no necesita
       NADA de acceso a datos. Que aquí no aparezca Npgsql no es un olvido: es
       la comprobación de que este proceso no puede llegar a PostgreSQL ni
       queriendo. -->

</Project>
