# La configuracion del front de React EN DESARROLLO.
#
# Vite lee este archivo con `npm run dev` y el .env.production con
# `npm run build`. No hay que acordarse de exportar nada.
#
# Apunta a localhost:8035 —la API del compose— y NO a `api-facturas`:
# ese nombre solo existe dentro de la red de Docker, y aqui quien hace la
# peticion es el navegador, que esta afuera.
VITE_URL_API=http://localhost:8035
